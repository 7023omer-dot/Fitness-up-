# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend — לשליחת ייצוא עסקאות למייל (resend.com, יש תוכנית חינמית)
RESEND_API_KEY=
# כתובת השולח חייבת להיות מאומתת ב-Resend (דומיין מאומת, או onboarding@resend.dev לבדיקות)
EMAIL_FROM=onboarding@resend.dev
# כתובת ברירת מחדל לשליחת הייצוא אליה (אפשר גם לבחור כתובת בזמן השליחה מהאפליקציה)
EMAIL_EXPORT_TO=

# Shopify — למשיכת הזמנות אוטומטית (Settings -> Apps -> Develop apps -> Admin API access token)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_API_TOKEN=
